// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. `url` is the pooled (pgBouncer) connection used at runtime;
// `directUrl` is the direct 5432 connection Prisma uses for migrations.
// See https://supabase.com/docs/guides/database/prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// One row per store that has installed the app. This is the tenant registry and
// the anchor for any future per-store data (plan, billing, preferences). The
// `domain` (e.g. "acme.myshopify.com") is the stable, human-identifiable key
// that every other store-owned table references.
model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  name          String?
  active        Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  discountRules DiscountRule[]
}

// A merchant-configured quantity discount rule. Editable source of truth; on
// save an ACTIVE rule is mirrored into a Shopify automatic discount + metafield.
model DiscountRule {
  id          String    @id @default(cuid())
  // Tenant key: the store's myshopify domain. Present on every store-owned row
  // so data is trivially attributable to a store, and FK-enforced against Shop
  // so a rule can never exist for an unknown/mismatched store.
  shop        String
  store       Shop      @relation(fields: [shop], references: [domain], onDelete: Cascade)

  title       String
  // DRAFT | ACTIVE
  status      String    @default("DRAFT")
  // PRODUCT | COLLECTION — what `targets` point at
  targetType  String    @default("PRODUCT")
  // JSON string: [{ "id": "gid://shopify/Product/1", "title": "..." }]
  targets     String    @default("[]")
  // Shopify automatic discount GID, null until synced
  discountGid String?
  // Optional scheduling window
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tiers DiscountTier[]

  @@index([shop])
  @@index([shop, status])
}

// One quantity threshold within a rule, e.g. minQuantity 5 -> 10% off. Scoped to
// a store transitively through its parent rule (cascade-deleted with it).
model DiscountTier {
  id          String   @id @default(cuid())
  ruleId      String
  rule        DiscountRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  minQuantity Int
  // PERCENTAGE | FIXED_AMOUNT
  valueType   String
  value       Float

  @@index([ruleId])
}
